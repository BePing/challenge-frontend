rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Computation Metadata - Allow public read access
    match /computation-metadata/{document} {
      allow read: if true;
      allow write: if false; // Only server-side writes via Admin SDK
    }
    
    // Region Summaries - Allow public read access
    match /region-summaries/{document} {
      allow read: if true;
      allow write: if false; // Only server-side writes via Admin SDK
    }
    match /region-summaries { allow list: if true; } // Allow collection queries
    
    // Rankings - Allow public read access
    match /rankings/{document} {
      allow read: if true;
      allow write: if false; // Only server-side writes via Admin SDK
    }
    
    // Player Points Details - Allow public read access
    match /players-points-details/{document} {
      allow read: if true;
      allow write: if false; // Only server-side writes via Admin SDK
    }
    
    // Tops (Legacy hierarchical structure) - Allow public read access
    match /tops/{document} {
      allow read: if true;
      allow write: if false; // Only server-side writes via Admin SDK
    }
    
    // Deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

